# Template for the real `.env` file that must exist on the EC2 host at the deploy
# directory (see DEPLOYMENT.md), read by docker-compose.prod.yml's `env_file:` for the
# backend container. Copy this to `.env` on the server and fill in real values --
# never commit the real file (it's already covered by .dockerignore / .gitignore).

# --- Required ---------------------------------------------------------------
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# --- Optional: first-boot Super Admin / Sub Admin seeding --------------------
# Only used once, when the super_admins/sub_admins collections are empty.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUB_ADMIN_NAME=
SEED_SUB_ADMIN_EMAIL=
SEED_SUB_ADMIN_PASSWORD=

# --- Optional: file uploads (S3) --------------------------------------------
# If unset, uploads fall back to local disk (public/uploads, mounted as the
# `uploads` named volume in docker-compose.prod.yml).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# --- Optional: outbound email (renewal reminders etc.) ----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
