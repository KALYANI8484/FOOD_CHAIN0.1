# Reference version of your EXISTING host nginx config (the one at
# /etc/nginx/sites-available/default on the EC2 box), with the changes needed to work
# with this repo's Docker setup. Diff this against your real file and apply the deltas --
# don't blindly overwrite it, since your version has the real Certbot-managed
# ssl_certificate paths already wired up correctly.
#
# What changed vs. what you pasted, and why:
#   1. `location /` now proxies to the frontend container (127.0.0.1:8080) instead of
#      reading `root /home/ubuntu/sid/FOOD_CHAIN0.1/dist` off disk -- the frontend is now
#      a Docker image built and pushed by CI, not a folder the pipeline rsyncs into place.
#   2. Added `location /socket.io/` -- this was missing before, so real-time features
#      (order radar broadcasts, live notifications) were likely not working over HTTPS.
#      It needs its own block because it requires the Upgrade/Connection headers, and
#      Socket.IO's default path (/socket.io/) isn't under /api.
#   3. Added `location /uploads/` -- server.js also serves uploaded files directly under
#      this path (in addition to /api/uploads/:key), which wasn't proxied before.
#   4. Added `location /health` -- so you (and the deploy pipeline, if you ever move
#      health checks to hit the public domain instead of the box's loopback) can check
#      https://vikramads.in/health.
#   5. `upstream backend_servers` is untouched -- it already points at 127.0.0.1:5000/
#      5001/5002, exactly matching docker-compose.prod.yml's three backend replicas.
#   6. The HTTP→HTTPS redirect server block is untouched.

upstream backend_servers {
    server 127.0.0.1:5000;
    server 127.0.0.1:5001;
    server 127.0.0.1:5002;
}

server {
    listen 443 ssl;
    server_name vikramads.in www.vikramads.in;

    ssl_certificate /etc/letsencrypt/live/vikramads.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vikramads.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # CHANGED: was `root /home/ubuntu/sid/FOOD_CHAIN0.1/dist;` + `try_files $uri $uri/ /index.html;`
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api {
        proxy_pass http://backend_servers;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # NEW
    location /socket.io/ {
        proxy_pass http://backend_servers;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # NEW
    location /uploads/ {
        proxy_pass http://backend_servers;
        proxy_set_header Host $host;
    }

    # NEW
    location /health {
        proxy_pass http://backend_servers/health;
        proxy_set_header Host $host;
    }

    client_max_body_size 50m;
}

server {
    listen 80;
    server_name vikramads.in www.vikramads.in;
    return 301 https://$host$request_uri;
}
